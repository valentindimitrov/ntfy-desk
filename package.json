{
  "name": "ntfy-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension to send and receive ntfy notifications",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/valentindimitrov/ntfy-desk.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "browse": "wxt build && node scripts/browse.ts",
    "website:dev": "vite --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts",
    "website:preview": "vite preview --config website/vite.config.ts",
    "website:screenshots": "wxt build --mode e2e && node scripts/website-screenshots.ts",
    "website:card": "node scripts/website-card.ts",
    "compile": "tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv3",
    "verify:packages": "node scripts/validate-packages.ts",
    "sign:chrome": "node scripts/sign-chrome.ts",
    "verify:crx": "node scripts/sign-chrome.ts --verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "check": "vp fmt --check && vp lint --deny-warnings && vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plus": "1.7.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@12.14.0"
}
