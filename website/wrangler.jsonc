// Cloudflare Worker that serves the static website build (static assets only, no Worker code).
// Deployed by the website job in .github/workflows/ci.yml; pull request previews are uploaded by
// .github/workflows/website-preview.yml. See website/README.md.
{
  "name": "ntfy-desk-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../.output/website",
    // /setup-instructions serves setup-instructions.html; an unknown address gets 404.html.
    // public/_redirects sends the old /getting-started on
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "ntfy-desk.minddevops.eu", "custom_domain": true }],
  "workers_dev": false,
  // Preview versions get their own workers.dev address (pr-<number>-…); production stays on the custom domain
  "preview_urls": true,
}
